---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '../styles/global.css';
// Fontes do topo da página pré-carregadas: evita que o texto mude de altura ao trocar de fonte (CLS).
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import frauncesItalicUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-italic.woff2?url';
import dmSansUrl from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url';
import Analytics from '../components/Analytics.astro';
import { doctor, booking, locations, nav, analytics, SITE_URL, telIntl, waLink } from '../data/site';
import { personSchema, websiteSchema, clinicSchema, breadcrumbSchema } from '../data/schema';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  breadcrumbs?: { name: string; href: string }[];
  ogType?: string;
}

const { title, description, schema = [], breadcrumbs, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const fullTitle = Astro.url.pathname === '/' ? title : `${title} | ${doctor.name}`;

const crumbs = breadcrumbs ? [{ name: 'Início', href: '/' }, ...breadcrumbs] : null;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    personSchema(),
    websiteSchema(),
    ...locations.map(clinicSchema),
    ...(crumbs ? [breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: new URL(c.href, SITE_URL).href })))] : []),
    ...schema,
  ],
};
const year = new Date().getFullYear();
const ativo = (href: string) => Astro.url.pathname.startsWith(href);
const slug = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z]+/g, '_');
const hasAnalytics = Boolean(analytics.ga4 || analytics.googleAds);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {[frauncesUrl, dmSansUrl].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#343538" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={doctor.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE_URL}/images/dr-alexandre-okubo-medico-dermatologista.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand">
          <span class="brand-name">{doctor.name}</span>
          <span class="brand-sub">Dermatologista</span>
        </a>
        <nav aria-label="Principal" class="nav-desktop">
          <ul>
            {nav.map((n) => n.children ? (
              <li>
                <details class="sub">
                  <summary class={n.children.some((c) => ativo(c.href)) ? 'is-active' : undefined}>{n.label}</summary>
                  <ul>
                    {n.children.map((c) => <li><a href={c.href} aria-current={ativo(c.href) ? 'page' : undefined}>{c.label}</a></li>)}
                  </ul>
                </details>
              </li>
            ) : (
              <li><a href={n.href} aria-current={ativo(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
            <li><a class="btn btn--sm" href="/onde-atendo/" data-agendar>Agendar consulta</a></li>
          </ul>
        </nav>
        <div class="header-mobile">
          <a class="btn btn--sm header-book" href="/onde-atendo/" data-agendar>Agendar</a>
          <details class="menu">
            <summary aria-label="Abrir menu"><span></span><span></span></summary>
            <nav aria-label="Principal (celular)">
              <ul>
                {nav.map((n) => n.children ? (
                  <li>
                    <span class="menu-group">{n.label}</span>
                    <ul class="menu-sub">
                      {n.children.map((c) => <li><a href={c.href} aria-current={ativo(c.href) ? 'page' : undefined}>{c.label}</a></li>)}
                    </ul>
                  </li>
                ) : (
                  <li><a href={n.href} aria-current={ativo(n.href) ? 'page' : undefined}>{n.label}</a></li>
                ))}
                <li class="menu-cta"><a class="btn" href="/onde-atendo/" data-agendar>Agendar consulta</a></li>
              </ul>
            </nav>
          </details>
        </div>
      </div>
    </header>

    {crumbs && (
      <nav class="wrap breadcrumb" aria-label="Trilha">
        {crumbs.map((c, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> / </span>}
            {i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
          </>
        ))}
      </nav>
    )}

    <main id="conteudo">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="footer-name">{doctor.name}</p>
          <p>Dermatologista · {doctor.crm} · {doctor.rqe}<br />Membro da Sociedade Brasileira de Dermatologia</p>
          <p class="footer-social">
            {doctor.social.map((r, i) => (
              <>{i > 0 && ' · '}<a href={r.url} rel="me noopener" target="_blank">{r.label}</a></>
            ))}
          </p>
        </div>
        {locations.map((l) => (
          <div>
            <p class="footer-label">{l.city}</p>
            <p><a href={`/onde-atendo/${l.slug}/`}>{l.shortName}</a><br />{l.street}{l.district && `, ${l.district}`}<br />{l.city}, {l.region}, {l.postalCode}{l.phone && <><br /><a href={`tel:${telIntl(l.phone)}`}>{l.phone}</a></>}</p>
          </div>
        ))}
      </div>
      <div class="wrap footer-legal">
        <p>Responsável técnico: {doctor.name} · {doctor.crm} · {doctor.rqe}. O conteúdo deste site é informativo e não substitui a consulta médica.</p>
        <p>© {year} {doctor.legalName} · <a href="/sobre/#avaliacoes">Avaliações de pacientes</a> · <a href="/privacidade/">Privacidade</a>{hasAnalytics && <> · <button type="button" class="linklike" data-consent-open>Preferências de cookies</button></>}</p>
      </div>
    </footer>
    <Analytics />
    <dialog class="agendar" id="agendar" aria-labelledby="agendar-t">
      <div class="agendar-head">
        <h2 id="agendar-t">Agendar consulta</h2>
        <button type="button" class="agendar-x" data-fechar aria-label="Fechar">×</button>
      </div>
      <p class="agendar-sub">Escolha onde quer ser atendido.</p>
      <div class="agendar-opcoes">
        {locations.map((l) => (
          <section class="agendar-op">
            <h3>{l.city === 'São Paulo' ? 'São Paulo' : l.city} <small>{l.shortName}{l.district ? `, ${l.district}` : ''}</small></h3>
            <p>{l.payment}</p>
            <div class="agendar-btns">
              {l.whatsapp
                ? <a class="btn btn--sm" href={waLink(l.phone)} rel="noopener" target="_blank" data-event={`agendar_${slug(l.city)}_whatsapp`}>WhatsApp</a>
                : <a class="btn btn--sm" href={`tel:${telIntl(l.phone)}`} data-event={`agendar_${slug(l.city)}_telefone`}>Ligar: {l.phone}</a>}
              <a class="btn btn--sm btn--ghost" href={booking.primaryUrl} rel="noopener" target="_blank" data-event={`agendar_${slug(l.city)}_doctoralia`}>Doctoralia</a>
            </div>
          </section>
        ))}
        <section class="agendar-op">
          <h3>Teleconsulta <small>por vídeo</small></h3>
          <p>Para retornos, acompanhamento e resultado de exames. Pintas, primeira consulta de lesões e procedimentos, só presencial.</p>
          <div class="agendar-btns">
            <a class="btn btn--sm" href={booking.primaryUrl} rel="noopener" target="_blank" data-event="agendar_teleconsulta_doctoralia">Doctoralia</a>
          </div>
        </section>
      </div>
      <p class="agendar-nota">Na Doctoralia, você escolhe a unidade e o horário.</p>
    </dialog>
    <script>
      const dlg = document.getElementById('agendar') as HTMLDialogElement | null;
      document.addEventListener('click', (ev) => {
        const t = ev.target as HTMLElement;
        if (dlg && t.closest('[data-agendar]')) {
          ev.preventDefault();
          (document.querySelector('details.menu') as HTMLDetailsElement | null)?.removeAttribute('open');
          dlg.showModal();
          return;
        }
        if (dlg && (t === dlg || t.closest('[data-fechar]'))) dlg.close();
        // Fecha o submenu "Tratamentos" ao clicar fora.
        document.querySelectorAll('details.sub[open]').forEach((d) => { if (!d.contains(t)) d.removeAttribute('open'); });
      });
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 16px; top: 16px; background: var(--white); padding: 8px 12px; z-index: 10; }

  .site-header { background: var(--sand); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 5; }
  .header-inner { display: flex; align-items: center; justify-content: space-between; min-height: 72px; gap: 16px; }
  .brand { text-decoration: none; color: var(--graphite); display: flex; flex-direction: column; line-height: 1.1; }
  .brand-name { font-family: var(--serif); font-size: 1.35rem; }
  .brand-sub { font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-text); margin-top: 4px; padding-top: 4px; border-top: 1px solid var(--gold); align-self: flex-start; }

  .nav-desktop { display: none; }
  .nav-desktop ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 22px; align-items: center; }
  .nav-desktop a:not(.btn) { color: var(--graphite); text-decoration: none; font-size: 0.95rem; }
  .nav-desktop a:not(.btn):hover, .nav-desktop a[aria-current='page'] { color: var(--gold-text); }
  .sub { position: relative; }
  .sub summary { list-style: none; cursor: pointer; font-size: 0.95rem; color: var(--graphite); }
  .sub summary::-webkit-details-marker { display: none; }
  .sub summary::after { content: ' ▾'; font-size: 0.75em; }
  .sub summary:hover, .sub summary.is-active { color: var(--gold-text); }
  .nav-desktop .sub ul { position: absolute; top: calc(100% + 14px); left: -16px; display: grid; gap: 0; min-width: 240px; padding: 8px 0; background: var(--white); border: 1px solid var(--line); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08); }
  .nav-desktop .sub ul a { display: block; padding: 8px 16px; }
  .menu-group { display: block; padding: 10px 0 2px; font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .menu .menu-sub { position: static; padding: 0 0 0 14px; border: 0; background: none; }
  .agendar { width: min(560px, 100vw - 24px); max-height: 90vh; border: 0; border-top: 3px solid var(--gold); padding: 20px; }
  .agendar::backdrop { background: rgba(52, 53, 56, 0.55); }
  .agendar-head { display: flex; justify-content: space-between; align-items: center; }
  .agendar-head h2 { margin: 0; font-size: 1.5rem; }
  .agendar-x { border: 0; background: none; font-size: 1.8rem; line-height: 1; cursor: pointer; }
  .agendar-sub { margin: 4px 0 14px; color: var(--muted); }
  .agendar-opcoes { display: grid; gap: 12px; }
  .agendar-op { border: 1px solid var(--line); padding: 12px 14px; }
  .agendar-op h3 { margin: 0; font-size: 1.15rem; }
  .agendar-op h3 small { font-family: var(--sans); font-size: 0.85rem; color: var(--muted); font-weight: 400; }
  .agendar-op p { margin: 4px 0 10px; font-size: 0.92rem; }
  .agendar-btns { display: flex; flex-wrap: wrap; gap: 8px; }
  .agendar-nota { font-size: 0.85rem; color: var(--muted); margin: 12px 0 0; }

  .menu summary { list-style: none; cursor: pointer; width: 44px; height: 44px; display: flex; flex-direction: column; justify-content: center; gap: 7px; padding: 10px; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary span { display: block; height: 1px; background: var(--graphite); }
  .menu ul { list-style: none; margin: 0; padding: 16px var(--gutter) 24px; position: absolute; left: 0; right: 0; top: 72px; background: var(--sand); border-bottom: 1px solid var(--line); }
  .menu li a:not(.btn) { display: block; padding: 10px 0; color: var(--graphite); text-decoration: none; font-size: 1.05rem; }
  .menu li a[aria-current='page'] { color: var(--gold-text); }
  .menu-cta { margin-top: 12px; }

  .header-mobile { display: flex; align-items: center; gap: 4px; }
  .header-book { min-height: 40px; padding: 0.45rem 0.9rem; }

  @media (min-width: 1000px) {
    .nav-desktop { display: block; }
    .header-mobile { display: none; }
  }

  .site-footer { background: var(--graphite); color: var(--sand); padding: 56px 0 24px; font-size: 0.95rem; margin-top: 0; }
  .site-footer a { color: var(--gold); }
  .footer-grid { display: grid; gap: 32px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .footer-name { font-family: var(--serif); font-size: 1.4rem; margin-bottom: 0.4rem; }
  .footer-label { font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); margin-bottom: 0.4rem; }
  .linklike { background: none; border: 0; padding: 0; font: inherit; color: var(--gold); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; cursor: pointer; }
  .footer-legal { border-top: 1px solid rgba(245, 239, 230, 0.15); margin-top: 32px; padding-top: 20px; font-size: 0.82rem; color: #c9c3b8; }
</style>
