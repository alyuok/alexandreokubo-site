---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { locations, booking, telIntl } from '../../data/site';

const title = 'Onde atendo: Vila Clementino (SP) e Santo André';
const description =
  'Locais de atendimento do Dr. Alexandre Okubo, dermatologista: Prime Dermatologia, na Vila Clementino, em São Paulo, e Clínica Portugal, em Santo André. Também atende por teleconsulta.';
---
<Base title={title} description={description} breadcrumbs={[{ name: 'Onde atendo', href: '/onde-atendo/' }]}>
  <div class="wrap page-head">
    <p class="eyebrow">Onde atendo</p>
    <h1>Dois endereços, o mesmo cuidado</h1>
    <p class="lead">Atendo na zona sul de São Paulo e no ABC. Escolha o local mais conveniente para você.</p>
  </div>
  <section class="section section--white">
    <div class="wrap grid grid--2">
      {locations.map((l) => (
        <div class="card">
          <h2 class="h3">{l.name}</h2>
          <p>{l.street}{l.district && `, ${l.district}`}<br />{l.city} – {l.region}, {l.postalCode}{l.phone && <><br /><a href={`tel:${telIntl(l.phone)}`}>{l.phone}</a></>}</p>
          <p class="signature">{l.payment}<br />{l.note}</p>
          <a href={`/onde-atendo/${l.slug}/`}>Detalhes e como chegar →</a>
        </div>
      ))}
    </div>
  </section>
  <section class="section">
    <div class="wrap prose">
      <h2 class="h3">Teleconsulta</h2>
      <p>
        Também atendo por teleconsulta, por vídeo, agendada pelo <a href={booking.primaryUrl} rel="noopener" target="_blank" data-event="doctoralia_teleconsulta">Doctoralia</a>.
        Ela serve para retornos e para acompanhar um tratamento em andamento, com a conversa sobre os exames. A avaliação de pintas com dermatoscopia, a primeira consulta de lesões que precisam ser tocadas e os
        procedimentos pedem a consulta presencial.
      </p>
    </div>
  </section>
  <Cta />
</Base>

<style>
  .h3 { font-size: 1.4rem; margin-top: 0; }
</style>
