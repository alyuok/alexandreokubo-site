---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import recepcaoPrime from '../../assets/recepcao-prime-dr-alexandre-okubo.webp';
import consultorioPrime from '../../assets/consultorio-prime-dr-alexandre-okubo.webp';
import Cta from '../../components/Cta.astro';
import { locations, booking, doctor, SITE_URL, telIntl, waLink, mapLink } from '../../data/site';
import { clinicId, PERSON_ID } from '../../data/schema';

export function getStaticPaths() {
  return locations.map((l) => ({ params: { slug: l.slug }, props: { loc: l } }));
}

const { loc } = Astro.props;
// Fotos reais de cada unidade (sem pacientes nem funcionários identificáveis).
const photosBySlug: Record<string, { src: ImageMetadata; alt: string }[]> = {
  'prime-dermatologia': [
    { src: recepcaoPrime, alt: 'Dr. Alexandre Okubo na recepção da Prime Dermatologia e Saúde Emocional, na Vila Clementino, em São Paulo' },
    { src: consultorioPrime, alt: 'Dr. Alexandre Okubo na sala de atendimento da Prime Dermatologia, na Vila Clementino, em São Paulo' },
  ],
};
const photos = photosBySlug[loc.slug] ?? [];
const place = `${loc.district ? loc.district + ', ' : ''}${loc.city}`;
const title = `Dermatologista em ${place} – ${loc.shortName}`;
const description = `${doctor.name}, dermatologista, atende na ${loc.name}: ${loc.street}, ${place} – ${loc.region}. ${loc.payment}.`;
const url = `${SITE_URL}/onde-atendo/${loc.slug}/`;
---
<Base
  title={title}
  description={description}
  breadcrumbs={[{ name: 'Onde atendo', href: '/onde-atendo/' }, { name: loc.shortName, href: `/onde-atendo/${loc.slug}/` }]}
  schema={[{ '@type': 'WebPage', '@id': `${url}#webpage`, url, name: title, description, inLanguage: 'pt-BR', about: { '@id': clinicId(loc.slug) }, mentions: { '@id': PERSON_ID } }]}
>
  <div class="wrap page-head">
    <p class="eyebrow">{loc.city}</p>
    <h1>{loc.name}</h1>
    <p class="lead">{loc.note}</p>
  </div>

  <section class="section section--white">
    <div class="wrap grid grid--2">
      <dl class="facts">
        <dt>Endereço</dt>
        <dd>{loc.street}{loc.district && `, ${loc.district}`}<br />{loc.city} – {loc.region}{loc.postalCode && `, ${loc.postalCode}`}</dd>
        {loc.phone && (<><dt>{loc.whatsapp ? 'Telefone e WhatsApp' : 'Telefone'}</dt><dd><a href={`tel:${telIntl(loc.phone)}`}>{loc.phone}</a></dd></>)}
        <dt>Forma de atendimento</dt>
        <dd>{loc.payment}</dd>
        <dt>Site da clínica</dt>
        <dd><a href={loc.url} rel="noopener" target="_blank">{loc.url.replace(/^https?:\/\/(www\.)?/, '')}</a></dd>
      </dl>
      <div>
        <p class="book-title">Como agendar</p>
        <p class="book-actions">
          {loc.whatsapp
            ? <a class="btn" href={waLink(loc.phone)} rel="noopener" target="_blank">Agendar pelo WhatsApp</a>
            : <a class="btn" href={`tel:${telIntl(loc.phone)}`}>Ligar para a {loc.shortName}</a>}
          <a class="btn btn--ghost" href={booking.primaryUrl} rel="noopener" target="_blank">Agendar pelo Doctoralia</a>
        </p>
        <p><a href={mapLink(loc)} rel="noopener" target="_blank">Abrir no Google Maps →</a></p>
      </div>
    </div>
  </section>

  {photos.length > 0 && (
    <section class="section">
      <div class="wrap">
        <p class="eyebrow">A unidade</p>
        <div class="grid grid--2">
          {photos.map((p) => (
            <figure class="framed-photo">
              <Image src={p.src} alt={p.alt} widths={[400, 640, 960]} sizes="(min-width: 700px) 45vw, 100vw" />
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <Cta />
</Base>

<style>
  .facts { margin: 0; }
  .facts dt { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--gold-text); margin-top: 16px; }
  .facts dd { margin: 4px 0 0; font-size: 1.1rem; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .book-title { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--gold-text); margin: 16px 0 12px; }
  .book-actions { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
