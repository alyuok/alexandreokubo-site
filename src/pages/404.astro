---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada" description="A página que você procurou não existe ou mudou de endereço.">
  <div class="wrap page-head prose">
    <p class="eyebrow">Erro 404</p>
    <h1>Página não encontrada</h1>
    <p class="lead">O endereço pode ter mudado. Você pode voltar ao <a href="/">início</a>, ler o <a href="/blog/">blog</a> ou ver <a href="/onde-atendo/">onde atendo</a>.</p>
  </div>
</Base>
