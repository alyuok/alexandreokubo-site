---
import Service from '../layouts/Service.astro';
import Related from '../components/Related.astro';

const groups = [
  {
    title: 'Injetáveis e fios',
    items: [
      { t: 'Toxina botulínica', d: 'Suaviza linhas de expressão relaxando músculos específicos, preservando a sua expressão.' },
      { t: 'Preenchimento com ácido hialurônico', d: 'Repõe volume e contorno em áreas selecionadas, com quantidade e pontos definidos na avaliação.' },
      { t: 'Bioestimuladores de colágeno', d: 'Ácido poli-L-láctico (PLLA), hidroxiapatita de cálcio e policaprolactona (PCL) estimulam a produção de colágeno para melhorar a firmeza da pele de forma gradual. O tipo é escolhido conforme a área e o objetivo.' },
      { t: 'Fios de PDO', d: 'Fios absorvíveis de polidioxanona, usados para sustentação e estímulo de colágeno em casos selecionados de flacidez.' },
    ],
  },
  {
    title: 'Lasers e tecnologias',
    items: [
      { t: 'Luz intensa pulsada', d: 'Indicada para manchas de sol e vasinhos do rosto e do colo, de acordo com o tipo de pele. Não é indicada para o melasma, pelo risco de piora.' },
      { t: 'Laser Nd:YAG 1064 nm', d: 'Laser de comprimento de onda longo, indicado conforme a avaliação para vasinhos, manchas e estímulo da pele, incluindo o modo toning para melasma.' },
      { t: 'Laser de érbio (Er:YAG) ablativo', d: 'Atua na camada superficial da pele para melhorar textura, rugas finas e cicatrizes, com tempo de recuperação definido na consulta.' },
      { t: 'Plasma', d: 'Tecnologia usada em áreas de flacidez leve e excesso de pele, como as pálpebras, em casos selecionados.' },
      { t: 'Microagulhamento robótico', d: 'Microperfurações controladas por equipamento, que estimulam o colágeno e melhoram textura e cicatrizes.' },
      { t: 'Depilação a laser', d: 'Laser de diodo para pelos indesejados. Age sobre o pigmento, por isso funciona em pelos escuros e não em pelos brancos ou muito claros.' },
    ],
  },
  {
    title: 'Manchas e melasma',
    items: [
      { t: 'Laser Nd:YAG no modo toning', d: 'Modo de baixa energia, específico para melasma, que age sobre o pigmento sem agredir a pele. Sempre associado ao tratamento tópico.' },
      { t: 'Microagulhamento com ácido tranexâmico', d: 'As microperfurações facilitam a entrada do ácido tranexâmico na pele (drug delivery), como parte do tratamento do melasma.' },
      { t: 'Peelings superficiais', d: 'Renovam a camada de pele com pigmento, como complemento aos cremes clareadores, em manchas e no melasma.' },
    ],
  },
  {
    title: 'Cicatrizes de acne',
    items: [
      { t: 'Subcisão', d: 'Libera, com agulha e anestesia local, as traves fibrosas que puxam a pele para baixo nas cicatrizes deprimidas, como as de aspecto ondulado.' },
      { t: 'CROSS', d: 'Aplicação pontual de ácido tricloroacético dentro das cicatrizes estreitas e profundas, em "picador de gelo", para estimular o colágeno.' },
      { t: 'Tratamento combinado', d: 'Subcisão, CROSS, lasers, microagulhamento e bioestimuladores podem ser associados, conforme o tipo de cicatriz, para melhorar a textura da pele marcada pela acne.' },
    ],
  },
];

const faq = [
  {
    q: 'A toxina botulínica deixa o rosto artificial?',
    a: 'Não deveria. O aspecto artificial costuma vir de dose ou pontos inadequados. Na avaliação, observo como o rosto se movimenta para tratar só o necessário, mantendo a expressão.',
  },
  {
    q: 'Quanto tempo dura o efeito da toxina botulínica?',
    a: 'Em geral, de 3 a 6 meses, variando de pessoa para pessoa e conforme a região tratada.',
  },
  {
    q: 'Qual a diferença entre preenchimento e bioestimulador?',
    a: 'O preenchimento com ácido hialurônico repõe volume de forma imediata em pontos específicos. O bioestimulador age aos poucos, estimulando a pele a produzir colágeno, e melhora a firmeza ao longo de semanas a meses.',
  },
  {
    q: 'Todo mundo pode fazer procedimentos estéticos?',
    a: 'Não. Gestação, amamentação, algumas doenças e medicamentos podem contraindicar procedimentos. Por isso a avaliação vem sempre antes, e às vezes a recomendação é não fazer.',
  },
];
---
<Service
  slug="dermatologia-estetica"
  eyebrow="Dermatologia estética"
  h1="O melhor resultado é aquele <em>que ninguém aponta</em>"
  title="Dermatologia estética: toxina, preenchimento, bioestimuladores e lasers"
  description="Dermatologia estética com o Dr. Alexandre Okubo: toxina botulínica, ácido hialurônico, bioestimuladores, fios de PDO, lasers e microagulhamento robótico na Vila Clementino, SP."
  lead="Procedimentos estéticos feitos por dermatologista, com avaliação antes da aplicação, indicação só do que faz sentido e foco em resultado natural."
  groups={groups}
  faq={faq}
>
  <Related
    items={[
      { href: '/blog/melasma/', label: 'Melasma: por que as manchas voltam e como controlar' },
      { href: '/blog/canetas-emagrecedoras-pele-unhas-ozempic-face/', label: 'Canetas emagrecedoras e o chamado "Ozempic face"' },
      { href: '/blog/cicatrizes-de-acne-subcisao/', label: 'Cicatrizes de acne: tipos, tratamentos e subcisão' },
      { href: '/blog/menopausa-e-pele/', label: 'Menopausa e pele: o que muda e o que pode ajudar' },
    ]}
  />
</Service>
