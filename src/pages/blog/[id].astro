---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { getPosts, formatDate } from '../../lib/posts';
import { doctor, SITE_URL } from '../../data/site';
import { PERSON_ID, WEBSITE_ID } from '../../data/schema';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const url = `${SITE_URL}/blog/${post.id}/`;

const schema = [
  {
    '@type': 'MedicalWebPage',
    '@id': `${url}#webpage`,
    url,
    name: d.title,
    description: d.description,
    inLanguage: 'pt-BR',
    isPartOf: { '@id': WEBSITE_ID },
    reviewedBy: { '@id': PERSON_ID },
    lastReviewed: d.reviewedDate.toISOString().slice(0, 10),
    about: d.about.map((name) => ({ '@type': 'MedicalCondition', name })),
    mainEntity: { '@id': `${url}#article` },
  },
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: d.title,
    description: d.description,
    author: { '@id': PERSON_ID },
    publisher: { '@id': PERSON_ID },
    datePublished: d.pubDate.toISOString().slice(0, 10),
    dateModified: d.reviewedDate.toISOString().slice(0, 10),
    citation: d.sources.map((s) => s.url),
    inLanguage: 'pt-BR',
  },
];
---
<Base
  title={d.title}
  description={d.description}
  ogType="article"
  breadcrumbs={[{ name: 'Blog', href: '/blog/' }, { name: d.title, href: `/blog/${post.id}/` }]}
  schema={schema}
>
  <article class="wrap post">
    <header class="page-head">
      {d.status === 'rascunho' && <p class="draft">RASCUNHO: AGUARDANDO APROVAÇÃO</p>}
      <p class="eyebrow">{d.category}</p>
      <h1>{d.title}</h1>
      <p class="byline">
        Por <a href="/sobre/" rel="author">{doctor.name}</a>, dermatologista · {doctor.crm} · {doctor.rqe}<br />
        Publicado em {formatDate(d.pubDate)} · Revisado em {formatDate(d.reviewedDate)}
      </p>
    </header>

    <div class="prose">
      <p class="answer"><strong>Resposta rápida:</strong> {d.answer}</p>
      <Content />

      {d.sources.length > 0 && (
        <section class="sources">
          <h2>Referências</h2>
          <ol>
            {d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}
          </ol>
        </section>
      )}

      <p class="notice">Este conteúdo é informativo e não substitui a consulta. Cada caso precisa de avaliação individual.</p>
    </div>
  </article>
  <div class="spacer"></div>
  <Cta />
</Base>

<style>
  .post .page-head { padding-bottom: 8px; max-width: 820px; }
  .byline { font-size: 0.92rem; color: var(--muted); border-top: 1px solid var(--gold); padding-top: 12px; display: inline-block; }
  .answer { background: var(--white); border-left: 2px solid var(--gold); padding: 18px 20px; font-size: 1.08rem; }
  .sources { font-size: 0.92rem; margin-top: 2.5rem; }
  .sources h2 { font-size: 1.2rem; }
  .draft { background: var(--graphite); color: var(--gold); display: inline-block; padding: 4px 10px; font-size: 0.75rem; letter-spacing: 0.08em; }
  .spacer { height: 64px; }
</style>
