---
// Google Analytics 4 + Google Ads com Consent Mode v2 (LGPD).
// Nada é carregado enquanto os IDs em src/data/site.ts estiverem vazios.
// Os cookies de medição só são ativados depois que o visitante aceita.
import { analytics } from '../data/site';

const { ga4, googleAds, adsConversions } = analytics;
const enabled = Boolean(ga4 || googleAds);
const primaryId = ga4 || googleAds;
const config = JSON.stringify({ ga4, googleAds, adsConversions });
---
{enabled && (
  <>
    <script is:inline define:vars={{ primaryId, config }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
      try {
        if (localStorage.getItem('consent') === 'granted') {
          gtag('consent', 'update', { ad_storage: 'granted', ad_user_data: 'granted', analytics_storage: 'granted' });
        }
      } catch (e) {}
      gtag('js', new Date());
      const cfg = JSON.parse(config);
      if (cfg.ga4) gtag('config', cfg.ga4);
      if (cfg.googleAds) gtag('config', cfg.googleAds);
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + primaryId;
      document.head.appendChild(s);

      // Cliques de contato viram eventos (e conversões no Google Ads, quando configuradas).
      document.addEventListener('click', (ev) => {
        const a = ev.target.closest && ev.target.closest('a[href]');
        if (!a) return;
        const href = a.getAttribute('href') || '';
        let kind = null;
        // Ver avaliações não é agendamento: vira evento próprio, sem conversão no Google Ads.
        if (a.dataset.event === 'avaliacoes') kind = 'avaliacoes';
        else if (href.includes('wa.me/')) kind = 'whatsapp';
        else if (href.includes('doctoralia.com.br')) kind = 'doctoralia';
        else if (href.startsWith('tel:')) kind = 'telefone';
        // Rota no mapa: evento próprio, sem conversão no Google Ads.
        else if (href.includes('google.com/maps')) kind = 'rota';
        if (!kind) return;
        gtag('event', 'contato_' + kind, { link_url: href, page_path: location.pathname, origem: a.dataset.event || '' });
        const label = cfg.adsConversions && cfg.adsConversions[kind];
        if (cfg.googleAds && label) gtag('event', 'conversion', { send_to: cfg.googleAds + '/' + label });
      });
    </script>

    <div id="consent" class="consent" role="region" aria-label="Preferências de cookies" hidden>
      <p>Usamos cookies de medição para melhorar o site. <a href="/privacidade/">Saiba mais</a>.</p>
      <div class="consent-actions">
        <button type="button" class="btn btn--sm" data-consent="granted">Aceitar</button>
        <button type="button" class="btn btn--sm btn--ghost" data-consent="denied">Recusar</button>
      </div>
    </div>
    <script is:inline>
      (function () {
        const box = document.getElementById('consent');
        let saved = null;
        try { saved = localStorage.getItem('consent'); } catch (e) {}
        if (!saved) { box.hidden = false; document.documentElement.classList.add('consent-aberto'); }
        box.addEventListener('click', (ev) => {
          const choice = ev.target.dataset && ev.target.dataset.consent;
          if (!choice) return;
          try { localStorage.setItem('consent', choice); } catch (e) {}
          const state = choice === 'granted' ? 'granted' : 'denied';
          gtag('consent', 'update', { ad_storage: state, ad_user_data: state, analytics_storage: state });
          box.hidden = true;
          document.documentElement.classList.remove('consent-aberto');
        });
        // Link "Preferências de cookies" do rodapé reabre o aviso.
        document.addEventListener('click', (ev) => {
          const open = ev.target.closest && ev.target.closest('[data-consent-open]');
          if (!open) return;
          ev.preventDefault();
          box.hidden = false;
          const first = box.querySelector('button');
          if (first) first.focus();
        });
      })();
    </script>
  </>
)}

<style>
  .consent {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--white);
    border-top: 2px solid var(--gold);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
    padding: 10px 16px;
    font-size: 0.88rem;
    line-height: 1.4;
  }
  .consent[hidden] { display: none; }
  .consent p { margin: 0; flex: 1; }
  .consent-actions { display: flex; gap: 8px; flex: none; }
  .consent-actions .btn { min-height: 40px; padding: 0.4rem 0.9rem; }
  :global(html.consent-aberto body) { padding-bottom: 76px; }
  @media (min-width: 860px) {
    .consent { left: 16px; right: auto; bottom: 16px; max-width: 460px; border: 1px solid var(--line); border-top: 2px solid var(--gold); }
    :global(html.consent-aberto body) { padding-bottom: 0; }
  }
</style>
